# The Swift toolchain and Static Linux SDK that build the Host CLI (make host-cli).
# The SDK must be the one released with the image's Swift version: see
# https://www.swift.org/api/v1/install/releases.json, platform "static-sdk".
HOST_CLI_SWIFT_IMAGE=swift:6.4.2-noble
HOST_CLI_SDK_URL=https://download.swift.org/swift-6.4.2-release/static-sdk/swift-6.4.2-RELEASE/swift-6.4.2-RELEASE_static-linux-0.1.0.artifactbundle.tar.gz
