# The test EdDSA public key that a Debug build carries as SUPublicEDKey (scripts/stamp-debug-update-key.sh).
# Sparkle's updater refuses to start on an http feed without a key, and a verify suite serves its feed over
# http from its run directory. Its private half is scripts/verify/fixtures/sparkle-test-ed-key, so it signs
# nothing that a Release or Tip Build would install: those carry the release key from sparkle-public-key.env.
SPARKLE_DEBUG_PUBLIC_ED_KEY=KA9PqA5LArASCsN7GCrC08BszxYNh0wjgPrtwjXoTQM=
