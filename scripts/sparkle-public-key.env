# The release EdDSA public key that packaging stamps into the app's Info.plist as SUPublicEDKey.
# Sparkle installs only an update whose zip this key's private half signed.
# The release secrets script fills it once: make release-secrets.
# Never replace it, or every installed copy stops updating.
SPARKLE_PUBLIC_ED_KEY=0V+XMcT9S2CzEO0ZDsMYylWD9RA4rBG3Y2CqEn8ZVVE=
